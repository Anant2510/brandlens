{
  "name": "brandlens",
  "version": "0.1.0",
  "private": true,
  "description": "BrandLens — the brand intelligence verification layer. API-first, generator-agnostic, model-agnostic brand governance with auditable decision traces.",
  "engines": {
    "node": ">=20.11.0"
  },
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" build && pnpm -r --filter \"./apps/**\" build",
    "dev": "pm2 start infra/windows/ecosystem.config.cjs --only brandlens-api,brandlens-worker,brandlens-web,brandlens-engine",
    "dev:api": "pnpm --filter @brandlens/api start:dev",
    "dev:web": "pnpm --filter @brandlens/web dev",
    "dev:worker": "pnpm --filter @brandlens/worker start:dev",
    "db:generate": "pnpm --filter @brandlens/db generate",
    "db:migrate": "pnpm --filter @brandlens/db migrate",
    "db:seed": "pnpm --filter @brandlens/db seed",
    "db:reset": "pnpm --filter @brandlens/db reset",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\""
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
