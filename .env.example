# ============================================================================
# BrandLens — environment configuration
# Copy to `.env` at the repo root. Every service reads from this one file.
# ============================================================================

NODE_ENV=development
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Database  (PostgreSQL 15+ — native Windows install, no Docker required)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://brandlens:brandlens@localhost:5432/brandlens
DATABASE_POOL_MAX=20
DATABASE_SSL=false

# pgvector is optional. When absent, BrandLens automatically falls back to
# an in-SQL cosine similarity implementation over real[] columns.
# `auto` detects at boot. Force with `pgvector` or `fallback`.
VECTOR_DRIVER=auto

# ---------------------------------------------------------------------------
# Job queue  (pg-boss — Postgres-backed. No Redis required.)
# ---------------------------------------------------------------------------
QUEUE_SCHEMA=brandlens_queue
QUEUE_CONCURRENCY_CPU=4
QUEUE_CONCURRENCY_LLM=12
QUEUE_CONCURRENCY_DEFAULT=8
QUEUE_RETRY_LIMIT=3
QUEUE_RETRY_BACKOFF=true

# ---------------------------------------------------------------------------
# Discovery  (URL in, brand ontology out)
#
# The crawler needs a headless Chromium. Install it once with:
#   pnpm --filter @brandlens/worker exec playwright install chromium
#
# Set DISCOVERY_BROWSER_EXECUTABLE only if you want a specific binary — a
# Chrome the organisation already manages, or a Chromium whose build number
# does not match the one Playwright pins. Leave it empty to let Playwright
# resolve its own.
# ---------------------------------------------------------------------------
# DISCOVERY_BROWSER_EXECUTABLE=

# ---------------------------------------------------------------------------
# Object storage  (driver: local | s3 | azure)
# `local` writes to STORAGE_LOCAL_ROOT — the default for a single Windows VM.
#
# SET AN ABSOLUTE PATH IN PRODUCTION. A relative value is resolved against the
# workspace root so the API, the worker and `pnpm db:seed` agree, but PM2 gives
# each service a different cwd and an absolute path removes the question
# entirely. On the Windows VM this is C:\brandlens\.storage.
# ---------------------------------------------------------------------------
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./.storage
STORAGE_SIGNING_SECRET=change-me-storage-signing-secret
STORAGE_URL_TTL_SECONDS=900

# --- s3 driver ---
# S3_BUCKET_ORIGINALS=brandlens-originals
# S3_BUCKET_DERIVATIVES=brandlens-derivatives
# S3_REGION=us-east-1
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- azure driver ---
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_CONTAINER_ORIGINALS=originals
# AZURE_CONTAINER_DERIVATIVES=derivatives

# ---------------------------------------------------------------------------
# Services
# ---------------------------------------------------------------------------
API_PORT=4000
API_HOST=0.0.0.0
API_PUBLIC_URL=http://localhost:4000
WEB_PORT=3000
WEB_PUBLIC_URL=http://localhost:3000
ENGINE_PORT=8000
ENGINE_URL=http://127.0.0.1:8000
ENGINE_SHARED_SECRET=change-me-engine-shared-secret
ENGINE_TIMEOUT_MS=180000

NEXT_PUBLIC_API_URL=http://localhost:4000

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
API_KEY_PEPPER=change-me-api-key-pepper

# ---------------------------------------------------------------------------
# LLM / VLM providers   (BrandLens is model-agnostic by design)
#   judge  — the T2 vision judge. Use a DIFFERENT family than your generator
#            to avoid self-preference bias.
#   extract— brand-book ingestion / rule extraction (vision + long context)
#   text   — copy analysis, embeddings orchestration, assemble/predict
# ---------------------------------------------------------------------------
# provider: anthropic | openai | azure-openai | google | openai-compatible
LLM_JUDGE_PROVIDER=anthropic
LLM_JUDGE_MODEL=claude-sonnet-4-5-20250929
LLM_EXTRACT_PROVIDER=anthropic
LLM_EXTRACT_MODEL=claude-sonnet-4-5-20250929
LLM_TEXT_PROVIDER=anthropic
LLM_TEXT_MODEL=claude-sonnet-4-5-20250929

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-10-21
GOOGLE_API_KEY=
# OpenAI-compatible endpoint (vLLM, Ollama, LM Studio, Together, ...)
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=

# Embeddings. `hash` is a dependency-free deterministic fallback so the system
# boots with zero model downloads; switch to `openai` or `local` for real ones.
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1024
IMAGE_EMBEDDING_PROVIDER=hash
IMAGE_EMBEDDING_DIM=1024

# ---------------------------------------------------------------------------
# Judge behaviour & cost control
# ---------------------------------------------------------------------------
JUDGE_TEMPERATURE=0
JUDGE_SELF_CONSISTENCY_K=1
JUDGE_SELF_CONSISTENCY_ESCALATE_K=3
JUDGE_PRECEDENT_K=6
JUDGE_MAX_IMAGE_EDGE=1568
JUDGE_ABSTAIN_CONFIDENCE=0.55
JUDGE_ENABLE_PROMPT_CACHE=true

COST_TENANT_DAILY_USD_LIMIT=25
COST_JOB_USD_LIMIT=2.5
COST_DEGRADE_GRACEFULLY=true

# ---------------------------------------------------------------------------
# OCR  (driver: vlm | tesseract | paddle)
# `vlm` needs no native install — the right default for a Windows VM.
# ---------------------------------------------------------------------------
OCR_DRIVER=vlm
TESSERACT_CMD=

# ---------------------------------------------------------------------------
# Webhooks
# ---------------------------------------------------------------------------
WEBHOOK_SIGNING_ALGO=sha256
WEBHOOK_MAX_ATTEMPTS=8
WEBHOOK_TIMEOUT_MS=10000
