{
  "compilerOptions": {
    /* Nest needs CommonJS output: its DI relies on `emitDecoratorMetadata`,
     * which the TS transpiler only emits for CJS-compatible decorators. The
     * workspace packages are authored as ESM-flavoured TS but compile cleanly
     * to CJS because every relative specifier is either extensionless or
     * `.js`, both of which `require()` resolves. */
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2022",
    "lib": ["ES2022"],
    "declaration": false,
    "removeComments": false,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "../../",
    "baseUrl": "./",
    "incremental": false,
    "skipLibCheck": true,
    "strict": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node", "multer"],
    /* The workspace packages ship raw TypeScript (`main: src/index.ts`), so we
     * map them explicitly and let `tsc` pull them into this program. Emitted
     * specifiers are rewritten to relative paths by `tsc-alias` at build time. */
    "paths": {
      "@brandlens/contracts": ["../../packages/contracts/src/index.ts"],
      "@brandlens/db": ["../../packages/db/src/index.ts"],
      "@brandlens/db/schema": ["../../packages/db/src/schema/index.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
